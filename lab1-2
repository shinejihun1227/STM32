② 반복문 코드
USER CODE BEGIN 3 영역을 다음으로 변경합니다.
/* USER CODE BEGIN 3 */

GPIO_PinState button =
    HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);

uint32_t now = HAL_GetTick();

if (lastButton == GPIO_PIN_SET &&
    button == GPIO_PIN_RESET &&
    (now - lastPressTime) >= 50)
{
    HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
    lastPressTime = now;
}

lastButton = button;

/* USER CODE END 3 */
